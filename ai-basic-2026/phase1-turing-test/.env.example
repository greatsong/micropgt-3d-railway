# Anthropic Claude API (말투 변환 + AI 응답)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API (GPT 모델)
OPENAI_API_KEY=your_openai_api_key_here

# Google AI API (Gemini 모델)
GOOGLE_API_KEY=your_google_api_key_here

# Upstage API (Solar Pro 3)
UPSTAGE_API_KEY=your_upstage_api_key_here

# 교사 입장 코드. 프로덕션에서는 추측하기 어려운 값으로 직접 정한다 (미설정이면 입장 코드 로그인이 꺼진다)
TEACHER_PIN=

# 학생 이름·대화 보존 기간(일). 비워 두면 지우지 않는다
TURING_RETENTION_DAYS=

# 서버 포트 (기본값 4024)
PORT=4024

# 앱 서브패스
APP_BASE_PATH=/turing-test
